# =====================================================================================
#  VIDEO HÌNH QUE + NGƯỜI THẬT — CẤU HÌNH
#  Copy file này thành  config.env  rồi điền của bạn. Dòng để trống = bỏ qua tính năng đó.
#  KHÔNG bọc giá trị trong dấu nháy. KHÔNG chia sẻ config.env cho ai (chứa khoá của bạn).
#  Đọc HUONG-DAN-CAI-DAT.md để biết lấy từng thứ ở đâu.
# =====================================================================================

# --- 1) KHO VIDEO NỀN (video người thật) — BẮT BUỘC ---------------------------------
#   Thư mục bạn thả clip quay sẵn vào. Skill mặc định lấy clip MỚI NHẤT.
#   Windows ví dụ: D:\VIDEO GOC     ·  Mac/Linux ví dụ: /Users/ten/Videos/goc
VIDEO_NEN_DIR=
#   Số từ nghe được tối thiểu để coi clip là "có người nói" → chạy chế độ giong-goc.
NGUONG_TU_NOI=25

# --- 2) AI TẠO HÌNH QUE (Gommo / genful.ai) — BẮT BUỘC ------------------------------
#   Xem model nào đang ON: node scripts/gommo-client.mjs models --type image|video
#   Model đã tắt vẫn nhận job nhưng treo rồi lỗi → cả video hỏng.
GOMMO_MCP_URL=https://api.gommo.net/api/v2/gommo-mcp
GOMMO_MCP_KEY=
GOMMO_IMG_MODEL=google_image_gen_banana_2
GOMMO_IMG_MODEL_ALT=google_image_gen_banana_pro
GOMMO_IMG_RES=1k
GOMMO_IMG_MODE=vip
GOMMO_VID_MODEL=veo_3_1

# --- 3) GIỌNG ĐỌC (Vbee TTS) — chỉ cần cho chế độ voiceover -------------------------
#   Clip đã có tiếng người nói thì bỏ trống cũng được.
VBEE_API=
VBEE_APP_ID=
VBEE_VOICE=

# --- 4) NHẬN DIỆN & TÀI NGUYÊN (tuỳ chọn — thiếu thì video vẫn ra) ------------------
#   Logo góc dưới trái: file PNG nền trong suốt, chữ nằm ngang. Để trống = không gắn logo.
VIDEO_LOGO=
#   Nhạc nền: file mp3. Ngắn hơn video vẫn được, hệ tự lặp. Để trống = không có nhạc.
VIDEO_MUSIC=
#   Thư mục chứa font phụ đề (.otf/.ttf). Để trống = dùng font hệ thống.
VIDEO_FONTS=

# --- 5) KHO VIDEO LARK BASE (tuỳ chọn — nơi đẩy video chờ duyệt) --------------------
#   Bảng cần ít nhất: 1 cột chữ (caption) + 1 cột đính kèm (video).
#   Lấy ID cột: lark-cli base +field-list --base-token <base> --table-id <table> --as user
LARK_POST_BASE=
LARK_POST_TABLE=
LARK_POST_VIDEO_FIELD_ID=
LARK_POST_VIDEO_FIELD_NAME=Video
LARK_POST_CAPTION_FIELD=Nội dung
#   Cột ghi chú và cột phân loại — để trống nếu bảng của bạn không có.
LARK_POST_NOTE_FIELD=
LARK_POST_TYPE_FIELD=

# --- 6) ĐƯỜNG DẪN CÔNG CỤ (chỉ đổi nếu máy bạn cài khác) ---------------------------
PYTHON=python
LARK_CLI=lark-cli
